void DeviceHandler::HandleAddDevice(const httplib::Request& req, httplib::Response& res) {
    try {
        if (!onvif_gateway_) {
            api::utils::ResponseHelper::Error(res, -1, "ONVIF Gateway not enabled", 500);
            return;
        }

        auto body = json::parse(req.body);
        gateway::ONVIFDevice device;
        
        if (body.contains("xaddr")) {
            device.xaddr = body["xaddr"].get<std::string>();
        } else {
            api::utils::ResponseHelper::BadRequest(res, "Missing required field: xaddr");
            return;
        }
        
        if (body.contains("username")) {
            device.username = body["username"].get<std::string>();
        }
        if (body.contains("password")) {
            device.password = body["password"].get<std::string>();
        }

        std::string device_id = onvif_gateway_->AddDevice(device);
        
        json data = {
            {"device_id", device_id},
            {"xaddr", device.xaddr}
        };
        api::utils::ResponseHelper::Success(res, data, "Device added successfully");
    } catch (const json::exception& e) {
        ::utils::Logger::Get()->error("Parse request JSON failed: {}", e.what());
        api::utils::ResponseHelper::BadRequest(res, "Invalid JSON format");
    } catch (const std::exception& e) {
        ::utils::Logger::Get()->error("Add ONVIF device failed: {}", e.what());
        api::utils::ResponseHelper::Error(res, e);
    }
}


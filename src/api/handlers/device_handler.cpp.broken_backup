DeviceHandler::DeviceHandler(
    std::shared_ptr<gateway::ONVIFGateway> onvif_gateway,
    std::shared_ptr<gateway::ISAPIGateway> isapi_gateway,
    std::shared_ptr<gateway::DahuaGateway> dahua_gateway,
    std::shared_ptr<gateway::PSIAGateway> psia_gateway,
    std::shared_ptr<gateway::GB28181Gateway> gb28181_gateway,
    std::shared_ptr<gateway::LocalCameraGateway> local_camera_gateway,
    std::shared_ptr<streaming::StreamManager> stream_manager) 
    : onvif_gateway_(onvif_gateway),
      isapi_gateway_(isapi_gateway),
      dahua_gateway_(dahua_gateway),
      psia_gateway_(psia_gateway),
      gb28181_gateway_(gb28181_gateway),
      local_camera_gateway_(local_camera_gateway),
      stream_manager_(stream_manager) {
    // 注册所有协议适配器
    if (onvif_gateway) {
        adapter_registry_.Register(std::make_shared<ONVIFDeviceAdapter>(onvif_gateway));
    }
    if (isapi_gateway) {
        adapter_registry_.Register(std::make_shared<ISAPIDeviceAdapter>(isapi_gateway));
    }
    if (dahua_gateway) {
        adapter_registry_.Register(std::make_shared<DahuaDeviceAdapter>(dahua_gateway));
    }
    if (psia_gateway) {
        adapter_registry_.Register(std::make_shared<PSIADeviceAdapter>(psia_gateway));
    }
    if (gb28181_gateway) {
        adapter_registry_.Register(std::make_shared<GB28181DeviceAdapter>(gb28181_gateway));
    }
}

std::shared_ptr<IDeviceAdapter> DeviceHandler::GetAdapter(const std::string& protocol) {
    return adapter_registry_.Get(protocol);
}

// ONVIF 设备管理（直接调用Gateway）
void DeviceHandler::HandleDiscoverDevices(const httplib::Request& req, httplib::Response& res) {
    try {
        if (!onvif_gateway_) {
            api::utils::ResponseHelper::Error(res, -1, "ONVIF Gateway not enabled", 500);
            return;
        }

        // 解析超时参数
        int timeout_seconds = 5;
        if (!req.body.empty()) {
            try {
                auto body = json::parse(req.body);
                timeout_seconds = body.value("timeout_seconds", 5);
            } catch (const json::exception& e) {
                // 使用默认值
            }
        }

        // 调用Gateway发现设备
        auto devices = onvif_gateway_->DiscoverDevices(timeout_seconds);

        // 构造响应
        json response_data = {
            {"devices", json::array()},
            {"count", devices.size()}
        };

        for (const auto& device : devices) {
            json device_json;
            device_json["id"] = device.id;
            device_json["xaddr"] = device.xaddr;
            device_json["types"] = device.types;
            device_json["scopes"] = device.scopes;
            device_json["manufacturer"] = device.manufacturer;
            device_json["model"] = device.model;
            device_json["serial_number"] = device.serial_number;
            device_json["hardware_id"] = device.hardware_id;
            if (!device.username.empty()) {
                device_json["has_credentials"] = true;
            } else {
                device_json["has_credentials"] = false;
            }
            auto time_since_epoch = std::chrono::duration_cast<std::chrono::seconds>(
                device.last_seen.time_since_epoch()).count();
            device_json["last_seen"] = time_since_epoch;
            
            response_data["devices"].push_back(device_json);
        }

        api::utils::ResponseHelper::Success(res, response_data, "Device discovery completed");
    } catch (const std::exception& e) {
        ::utils::Logger::Get()->error("Discover ONVIF devices failed: {}", e.what());
        api::utils::ResponseHelper::Error(res, e);
    }
}

void DeviceHandler::HandleGetDevices(const httplib::Request& req, httplib::Response& res) {
    // 从查询参数中获取协议类型
    std::string protocol = req.get_param_value("protocol");
    
    // 如果没有指定协议，默认使用onvif（向后兼容）
    if (protocol.empty()) {
        protocol = "onvif";
    }
    
    auto adapter = GetAdapter(protocol);
    if (adapter) {
        adapter->HandleGetDevices(req, res);
    } else {
        // 如果协议未启用，返回空设备列表而不是错误（避免前端阻塞）
        json response_data = {
            {"devices", json::array()},
            {"count", 0}
        };
        api::utils::ResponseHelper::Success(res, response_data, "Protocol not enabled");
    }
}

void DeviceHandler::HandleGetDevice(const httplib::Request& req, httplib::Response& res) {
    try {
